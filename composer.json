{
  "name": "qidus-asset/platform",
  "description": "QIDUS ASSET — Dual-department (Asset Dept & Finance/Procurement/Docs Dept) platform for Orthodox Sunday Schools",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "chillerlan/php-qrcode": "^5.0",
    "dompdf/dompdf": "^3.0",
    "guzzlehttp/guzzle": "^7.9",
    "monolog/monolog": "^3.7",
    "phpoffice/phpspreadsheet": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "robmorgan/phinx": "^0.16"
  },
  "autoload": {
    "psr-4": {
      "QidusAsset\\": "backend/src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
